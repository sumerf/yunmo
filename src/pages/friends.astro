---
import BaseLayout from "../layouts/BaseLayout.astro";
import FriendCard from "../components/FriendCard.astro";
import { friends } from "../data/friends";
---

<BaseLayout title="友链">
  <div class="content-wrap">
    <section class="glass friends">
      <div class="friends-head">
        <h1>友链</h1>
        <p class="muted">从数据列表自动渲染，头像加载失败会自动回退。</p>
      </div>
      <div class="friend-grid">
        {friends.map((friend) => <FriendCard friend={friend} />)}
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline src="/scripts/friends-ui.js"></script>

<style is:global>
  .friends {
    padding: 30px;
    border-radius: 36px;
  }
  .friends-head {
    display: grid;
    gap: 4px;
    margin-bottom: 18px;
  }
  .friends-head h1 {
    margin: 0;
  }
  .friend-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .friend-card {
    display: grid;
    grid-template-columns: 42px minmax(0, 1fr);
    gap: 10px;
    align-items: center;
    min-height: 72px;
    padding: 12px 13px;
    border-radius: 18px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.54), rgba(255, 255, 255, 0.2));
    border: 1px solid rgba(255, 255, 255, 0.42);
    box-shadow:
      0 10px 24px rgba(30, 41, 59, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.68);
    backdrop-filter: blur(18px) saturate(150%);
    -webkit-backdrop-filter: blur(18px) saturate(150%);
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease, box-shadow 180ms ease;
  }
  .friend-card:hover {
    transform: translateY(-2px);
    border-color: rgba(255, 255, 255, 0.58);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.64), rgba(255, 255, 255, 0.24));
    box-shadow:
      0 14px 30px rgba(30, 41, 59, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.74);
  }
  .friend-avatar {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 13px;
    background: transparent;
    border: 0;
    box-shadow: none;
    overflow: hidden;
  }
  .friend-card img {
    width: 42px;
    height: 42px;
    border-radius: 13px;
    object-fit: cover;
  }
  .friend-copy {
    display: grid;
    gap: 4px;
    min-width: 0;
  }
  .friend-copy strong {
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .friend-copy span {
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.38;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  html[data-resolved-theme="dark"] .friend-card {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.03));
    border-color: rgba(255, 255, 255, 0.12);
    box-shadow:
      0 12px 28px rgba(0, 0, 0, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }
  html[data-resolved-theme="dark"] .friend-card:hover {
    border-color: rgba(255, 255, 255, 0.2);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.04));
  }
  html[data-resolved-theme="dark"] .friend-avatar {
    background: transparent;
    border: 0;
    box-shadow: none;
  }
  @media (max-width: 720px) {
    .friends {
      padding: 22px;
      border-radius: 22px;
    }
    .friend-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 520px) {
    .friend-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
