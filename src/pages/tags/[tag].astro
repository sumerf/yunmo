---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import Pagination from "../../components/Pagination.astro";
import { getAllPosts, getAllTags, getPostsByTag, TAG_POSTS_PAGE_SIZE } from "../../utils/content";

export async function getStaticPaths() {
  const posts = await getAllPosts();
  const tags = getAllTags(posts);
  return tags.map((tag) => ({
    params: { tag: encodeURIComponent(tag) },
    props: {
      tag,
      posts: getPostsByTag(posts, tag)
    }
  }));
}

const { tag, posts } = Astro.props;
const featuredPosts = posts.slice(0, TAG_POSTS_PAGE_SIZE);
const totalPages = Math.ceil(posts.length / TAG_POSTS_PAGE_SIZE);
---

<BaseLayout title={`#${tag}`}>
  <div class="content-wrap">
    <section class="content-stack">
      <h1 class="section-title">#{tag}</h1>
      {featuredPosts.map((post) => <PostCard post={post} />)}
    </section>
    <Pagination currentPage={1} totalPages={totalPages} baseUrl={`/tags/${encodeURIComponent(tag)}`} />
  </div>
</BaseLayout>
