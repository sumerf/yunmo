---
const { currentPage, totalPages, baseUrl = "/" } = Astro.props;

const buildPageUrl = (page) => {
  if (page <= 1) return baseUrl;
  const normalized = baseUrl.endsWith("/") ? baseUrl.slice(0, -1) : baseUrl;
  return `${normalized}/page/${page}/`;
};
---

{totalPages > 1 && (
  <nav class="pagination" aria-label="分页导航">
    <div class="page-numbers">
      <a
        class:list={["page-link", "icon-link", { disabled: currentPage <= 1 }]}
        href={currentPage > 1 ? buildPageUrl(currentPage - 1) : undefined}
        aria-disabled={currentPage <= 1 ? "true" : "false"}
        aria-label="上一页"
      >
        <span aria-hidden="true">‹</span>
      </a>
      {Array.from({ length: totalPages }, (_, index) => index + 1).map((page) => (
        <a
          class:list={["page-link", "number", { active: page === currentPage }]}
          href={buildPageUrl(page)}
          aria-current={page === currentPage ? "page" : undefined}
        >
          {page}
        </a>
      ))}
      <a
        class:list={["page-link", "icon-link", { disabled: currentPage >= totalPages }]}
        href={currentPage < totalPages ? buildPageUrl(currentPage + 1) : undefined}
        aria-disabled={currentPage >= totalPages ? "true" : "false"}
        aria-label="下一页"
      >
        <span aria-hidden="true">›</span>
      </a>
    </div>
  </nav>
)}

<style>
  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 14px;
    margin-top: 24px;
    flex-wrap: wrap;
  }
  .page-numbers {
    display: flex;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .page-link {
    min-width: 42px;
    height: 42px;
    padding: 0 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.22);
    border: 1px solid rgba(255, 255, 255, 0.32);
    color: var(--text);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(14px) saturate(135%);
    -webkit-backdrop-filter: blur(14px) saturate(135%);
    box-shadow:
      0 1px 2px rgba(15, 23, 42, 0.08),
      0 6px 18px rgba(15, 23, 42, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.28);
    transition:
      transform 180ms ease,
      background 180ms ease,
      border-color 180ms ease,
      color 180ms ease,
      box-shadow 180ms ease;
  }
  .page-link:hover {
    transform: translateY(-1px);
    background: rgba(255, 255, 255, 0.3);
    border-color: rgba(255, 255, 255, 0.38);
    box-shadow:
      0 2px 4px rgba(15, 23, 42, 0.08),
      0 10px 22px rgba(15, 23, 42, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.34);
  }
  .page-link.active {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.92), rgba(255, 255, 255, 0.72));
    color: var(--accent-strong);
    border-color: rgba(255, 255, 255, 0.5);
    box-shadow:
      0 2px 4px rgba(15, 23, 42, 0.08),
      0 10px 24px rgba(200, 93, 134, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.72);
  }
  .page-link.number {
    min-width: 42px;
    padding: 0;
  }
  .icon-link {
    min-width: 42px;
    padding: 0;
    font-size: 1.2rem;
  }
  .page-link.disabled {
    opacity: 0.4;
    pointer-events: none;
  }
  :global(html[data-resolved-theme="dark"] .page-link) {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.1);
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.22),
      0 8px 20px rgba(0, 0, 0, 0.16),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }
  :global(html[data-resolved-theme="dark"] .page-link:hover) {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.14);
  }
  :global(html[data-resolved-theme="dark"] .page-link.active) {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0.12));
    border-color: rgba(255, 255, 255, 0.16);
    color: #fff2f7;
  }
  @media (max-width: 720px) {
    .page-link {
      min-width: 38px;
      height: 38px;
      padding: 0 12px;
    }
    .page-link.number {
      min-width: 38px;
    }
    .icon-link {
      min-width: 38px;
    }
  }
</style>
